# Copy to .env and fill in. Never commit .env.

# --- AI Scout (Swipe Pile scan) ---
OPENAI_API_KEY=
# OPENAI_SCOUT_MODEL=gpt-5.1

# --- PayPal sandbox demo (optional, Labs tab) ---
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_STANDARD_PLAN_ID=
PAYPAL_SAVER_PLAN_ID=
PAYPAL_DEMO_SUBSCRIPTION_ID=
PAYPAL_DEMO_ACTION_KEY=

# --- Optional ---
# DATABASE_URL=sqlite:///./redealer.db
# SCOUT_INTERVAL_SECONDS=1800

# --- Hosting (optional) ---
# Set a password to require sign-in on every page and API route. Leave blank on localhost.
# APP_USERNAME=redeal
# APP_PASSWORD=
